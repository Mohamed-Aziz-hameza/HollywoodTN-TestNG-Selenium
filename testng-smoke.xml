<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Suite de fumée (5 tests critiques : TC01, TC04, TC12, TC14, TC17)
  Lancement : mvn clean test -Dsuite.file=testng-smoke.xml
-->
<suite name="Suite Smoke Hollywood.tn" verbose="1" preserve-order="true">
  <listeners>
    <listener class-name="tn.hollywood.listeners.TestListener"/>
  </listeners>

  <test name="Smoke - parcours critiques">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <classes>
      <class name="tn.hollywood.tests.HomePageTest"/>
      <class name="tn.hollywood.tests.SearchTest"/>
      <class name="tn.hollywood.tests.ProductTest"/>
      <class name="tn.hollywood.tests.CartTest"/>
      <class name="tn.hollywood.tests.AccountTest"/>
    </classes>
  </test>
</suite>
