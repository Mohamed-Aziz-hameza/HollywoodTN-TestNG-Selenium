<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Suite complète : 20 tests fonctionnels du site https://hollywood.tn
  Lancement : mvn clean test
-->
<suite name="Suite Tests Fonctionnels Hollywood.tn" verbose="1" preserve-order="true">

  <!-- Rapport HTML + captures d'écran + traces d'exceptions -->
  <listeners>
    <listener class-name="tn.hollywood.listeners.TestListener"/>
  </listeners>

  <test name="Tests fonctionnels Hollywood.tn" preserve-order="true">
    <classes>
      <class name="tn.hollywood.tests.HomePageTest"/>      <!-- TC01 - TC03 -->
      <class name="tn.hollywood.tests.SearchTest"/>        <!-- TC04 - TC07 -->
      <class name="tn.hollywood.tests.CategoryTest"/>      <!-- TC08 - TC10 -->
      <class name="tn.hollywood.tests.ProductTest"/>       <!-- TC11 - TC13 -->
      <class name="tn.hollywood.tests.CartTest"/>          <!-- TC14 - TC16 -->
      <class name="tn.hollywood.tests.AccountTest"/>       <!-- TC17 - TC18 -->
      <class name="tn.hollywood.tests.ContactQuoteTest"/>  <!-- TC19 - TC20 -->
    </classes>
  </test>

</suite>
